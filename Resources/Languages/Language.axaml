<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Add Resources Here  -->
    <system:String x:Key="ProtocolSimulator">协议模拟器</system:String>
    <system:String x:Key="Start">开始</system:String>
    <system:String x:Key="Save">保存</system:String>
    <system:String x:Key="BtnRefresh">刷新</system:String>
    <system:String x:Key="Connect">连接</system:String>
    <system:String x:Key="PlaceholderSerial">请选择串口</system:String>
    <system:String x:Key="ConnectionParameter">通信参数</system:String>
    <system:String x:Key="BaudRate">波特率</system:String>
    <system:String x:Key="Parity">奇偶校验</system:String>
    <system:String x:Key="DataBits">数据位</system:String>
    <system:String x:Key="StopBits">停止位</system:String>
    <system:String x:Key="SettingWindowTitle">通讯设置</system:String>
    <system:String x:Key="SerialPortDevice">串口设备</system:String>
    <system:String x:Key="CurrentStatus">当前状态：</system:String> 
</ResourceDictionary>