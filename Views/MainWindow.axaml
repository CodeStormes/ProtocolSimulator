<Window
    Height="650"
    Icon="/Assets/avalonia-logo.ico"
    Title="{DynamicResource ProtocolSimulator}"
    Width="1000"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="ProtocolSimulator.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ProtocolSimulator.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel
            Background="#1B3358"
            Grid.Row="0"
            Orientation="Horizontal">
            <Menu>
                <MenuItem Foreground="White" Header="设置" />
                <MenuItem Foreground="White" Header="文件" />
                <MenuItem Foreground="White" Header="帮助" />
            </Menu>
        </StackPanel>
        <Grid Column="*,3*" Row="1">
            <Grid Column="0" RowDefinitions="Auto,Auto,Auto,Auto" />
        </Grid>
    </Grid>
</Window>