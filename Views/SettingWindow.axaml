<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:ProtocolSimulator.ViewModels"
		x:DataType="vm:SettingWindowViewModel"
		xmlns:communicationViews="using:Zenner.Communication.Avalonia.Views"
		x:Class="ProtocolSimulator.Views.SettingWindow"
		Background="{DynamicResource SemiGrey0}"
		Width="500"
		Icon="/Assets/avalonia-logo.ico"
		Title="{DynamicResource SettingWindowTitle}"
		CanResize="False">
	<!-- <Grid RowDefinitions="*,auto">
		<Border
