						<TextBlock VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" Text="{DynamicResource Parity}"/>
						<ComboBox Grid.Column="0" Grid.Row="1" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity,Mode=TwoWay}"/>
						<TextBlock VerticalAlignment="Center" Grid.Column="1" Grid.Row="2" Text="{DynamicResource DataBits}"/>
						<ComboBox Grid.Column="0" Grid.Row="2" ItemsSource="{Binding DataBitsOptions}" SelectedItem="{Binding DataBits,Mode=TwoWay}"/>
						<TextBlock VerticalAlignment="Center" Grid.Column="1" Grid.Row="3" Text="{DynamicResource StopBits}"/>
