			<Button Theme="{DynamicResource SolidButton}" Classes="Danger" Content="Cancel" Width="80" Click="Cancel_Click"/>
		</StackPanel>
	</Grid> -->
<communicationViews:CommunicationPanel DataContext="{Binding CommunicationPanel}"/>
	
</Window>
